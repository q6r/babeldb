{
  "schema": "babeldb-benchdata-manifest/1",
  "datasets_version": 1,
  "generator": "src/datasets.rs; regenerate with: cargo bench --bench engine -- gen-manifest",
  "note": "Synthetic scenarios are explicit hypotheses standing in for a production corpus, which is not available (spec section 11). Results on them do not predict results on real data.",
  "determinism": "Every record is a pure function of (scenario, seed, i, value_size) using integer arithmetic, splitmix64 and BLAKE3; S6 also depends on libzstd level-3 output. The first n records of a larger dataset are the n-record dataset.",
  "zstd_library": "1.5.7",
  "digest": "BLAKE3 over, for i in 0..records: u64 LE key length, key, u64 LE value length, value",
  "default_seed": 42,
  "scenarios": [
    {
      "id": "s1",
      "name": "s1-repetitive",
      "key_format": "s1-repetitive/{i:012}",
      "description": "Even i: value_size zero bytes. Odd i: a random motif of 2..=64 bytes repeated up to value_size (the last repetition is truncated).",
      "hypothesis": "Runs and exact repetitions (padding, fills, sparse blobs) are represented by RepeatV1 or a compressor at a tiny fraction of their size; BabelPure stays at Raw size by construction.",
      "parameters": {
        "zero_records": "even i",
        "motif_bytes": "2..=64 (odd i)"
      }
    },
    {
      "id": "s2",
      "name": "s2-sequences",
      "key_format": "s2-sequences/{i:012}",
      "description": "Consecutive little-endian u64 terms of an arithmetic progression with a per-record start < 2^48 and step in 1..=65536; a trailing partial term (value_size not a multiple of 8) is the little-endian prefix of the next term.",
      "hypothesis": "Counters, offset tables and timestamps are recognized exactly by ArithmeticU64V1 (constant-size body) when the unit length is a multiple of 8.",
      "parameters": {
        "start": "< 2^48",
        "step": "1..=65536",
        "element": "u64 little-endian"
      }
    },
    {
      "id": "s3",
      "name": "s3-chat-json",
      "key_format": "ch/{channel:08}/msg/{snowflake:020}",
      "description": "Discord-like message JSON {id, channel_id, author {id, username}, content, timestamp, mentions [], pinned false}. id is a snowflake (Discord epoch, 42-bit ms timestamp << 22 | worker << 17 | process << 12 | increment); messages are sent 100 ms apart on average, so snowflakes increase with i. channel: 1000 channels, Zipf (exponent 1) over channel popularity. author: 10000 users, skewed. content: words of a fixed 256-word list, padded so that the value is exactly value_size bytes whenever value_size is at least the fixed template (about 200 bytes).",
      "hypothesis": "Chat-scale workload: many small records sharing a fixed JSON template and a small vocabulary; a reverse prefix scan of a channel returns its latest messages.",
      "parameters": {
        "channels": 1000,
        "users": 10000,
        "discord_epoch_unix_ms": 1420070400000,
        "first_message_unix_ms": 1735689600000,
        "mean_gap_ms": 100,
        "channel_popularity": "Zipf exponent 1, integer weights 2^32/(rank+1), rank -> channel (rank*337+211) mod 1000",
        "vocabulary_words": 256,
        "template_bytes_record0": 213,
        "latest_query": "ScanOptions::prefix(channel_prefix(c)).reverse(true).limit(50).with_values(true)"
      }
    },
    {
      "id": "s4",
      "name": "s4-duplicates",
      "key_format": "s4-duplicates/{i:012}",
      "description": "Exactly 3 of every 10 consecutive records (never record 0) are exact copies of the value of an earlier record chosen uniformly in [0, i); every other value is BLAKE3-XOF output (incompressible).",
      "hypothesis": "Byte-verified dedupe removes exact duplicates. Only values stored as objects (length > inline_max) can be deduplicated, and compression cannot help because the base values are high entropy.",
      "parameters": {
        "duplicates_per_10_records": 3,
        "source": "uniform in [0, i)",
        "base_values": "BLAKE3 XOF"
      }
    },
    {
      "id": "s5",
      "name": "s5-high-entropy",
      "key_format": "s5-high-entropy/{i:012}",
      "description": "BLAKE3 XOF output derived from (seed, i); the planner does not know the seed.",
      "hypothesis": "Incompressible data: every Adaptive candidate falls back to Raw and the envelope/manifest overhead is pure cost.",
      "parameters": {
        "generator": "BLAKE3 derive_key XOF over (seed, i)"
      }
    },
    {
      "id": "s6",
      "name": "s6-compressed",
      "key_format": "s6-compressed/{i:012}",
      "description": "One zstd level-3 frame per record of S3-like JSON-lines chat text; the text length is searched (secant method, at most 8 compressions, stopping within 2 %) and the frame closest to value_size is kept, so sizes vary a few percent around value_size (see min/max_value_len in the manifest).",
      "hypothesis": "Already-compressed payloads (attachments, .zst files): recompression gains nothing and costs CPU; the planner must fall back to Raw.",
      "parameters": {
        "zstd_level": 3,
        "size_search": "closest frame to value_size in at most 8 compressions, stop within 2 %",
        "text": "JSON lines of S3-like messages of one channel"
      }
    }
  ],
  "variants": [
    {
      "name": "raw-backend",
      "description": "keys/values written directly to Table::Records through the Store trait, no engine format (backend reference)"
    },
    {
      "name": "engine-raw",
      "description": "engine with RawV1 only, no dedupe (Config::raw_only): format overhead baseline"
    },
    {
      "name": "babel-pure",
      "description": "Mode::BabelPure: every unit stored as its BabelAffineV1 seed (no dedupe)"
    },
    {
      "name": "lz4",
      "description": "Adaptive restricted to Lz4V1 + RawV1, no dedupe"
    },
    {
      "name": "zstd",
      "description": "Adaptive restricted to ZstdV1 (no dictionary) + RawV1, no dedupe"
    },
    {
      "name": "adaptive-nodedupe",
      "description": "Adaptive with the default codec policy, dedupe off"
    },
    {
      "name": "adaptive",
      "description": "Adaptive with the default codec policy and byte-verified dedupe"
    }
  ],
  "benchmark_defaults": {
    "records": 20000,
    "value_size": 1024,
    "block_size": 16384,
    "inline_max": 1024,
    "cache_bytes": 67108864,
    "backend_cache_bytes": 67108864,
    "batch": 1000,
    "durable_puts": 200,
    "ops": 10000,
    "dist": "uniform",
    "zipf_theta": 0.99,
    "readers": "logical CPUs",
    "range_len": 100,
    "latest_limit": 50,
    "verify_every": 64
  },
