{
  "name": "babeldb",
  "version": "0.1.1",
  "description": "Embedded key-value store (babeldb: fjall + WAL, group-committed writes) as a native Node.js addon",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/q6r/babeldb.git",
    "directory": "bindings/node"
  },
  "keywords": [
    "database",
    "key-value",
    "embedded",
    "storage",
    "napi-rs"
  ],
  "private": false,
  "napi": {
    "binaryName": "babeldb",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin"
    ],
    "dtsHeaderFile": "dts-header.d.ts"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "engines": {
    "node": ">= 18"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node --test __test__/babeldb.test.mjs",
    "bench": "node bench.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.5"
  }
}
